# Core Infrastructure Environment Variables
PORT=5000
NODE_ENV=development

# MongoDB Application Database
MONGODB_URI=mongodb://localhost:27017/ai_commerce_db
MONGODB_DB_NAME=ai_commerce_db

# Neo4j Knowledge Graph & Vector RAG Layer
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123

# Redis Cache / Idempotency / Session Store
REDIS_URL=redis://localhost:6379

# Security & Authentication
JWT_SECRET=super-secret-jwt-key-change-in-production-2026!
JWT_EXPIRES_IN=7d

# Razorpay Test Mode Payment Gateway
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=rzp_test_placeholder_key_secret
RAZORPAY_WEBHOOK_SECRET=rzp_test_placeholder_webhook_secret

# AI & LLM Provider (Gemini API)
GEMINI_API_KEY=AIzaSyBTCjMQk0nr4O506S4SeeYQUbeUGrz6MAE
GEMINI_MODEL=gemini-2.5-flash

# Features & Configuration
DEMO_MODE=true
ENABLE_VECTOR_SEARCH=true
